# ⚠️  INSECURE DEFAULTS — for local development only. Never use these values
# for anything reachable outside your machine.
#
# Copy this file to .env before running `docker compose up -d`:
#   cp .env.example .env

# -----------------------------
# Domain and external URL
# -----------------------------
ZITADEL_DOMAIN=localhost
# Zitadel's console/API port. Chosen to avoid colliding with the 5 apps'
# local ports (helmsman 3025/4025, chorus 3021/4021, warden 3020/4020,
# rolodex 3013/4013, yellow-pages 3023/4023).
PROXY_HTTP_PUBLISHED_PORT=8080
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
ZITADEL_PUBLIC_SCHEME=http

# -----------------------------
# Security/bootstrap
# -----------------------------
# Must be exactly 32 chars. Once Zitadel has been initialized with a
# masterkey it CANNOT be changed without losing access to encrypted data.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

# -----------------------------
# Pinned image tags
# To upgrade Zitadel, bump ZITADEL_VERSION and run:
#   docker compose pull && docker compose up -d --wait
# -----------------------------
ZITADEL_VERSION=v4.17.1
TRAEFIK_IMAGE=traefik:v3.7.7
POSTGRES_IMAGE=postgres:17.10-alpine

# -----------------------------
# Proxy settings
# -----------------------------
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACCESSLOG_ENABLED=true

# -----------------------------
# Postgres settings (Zitadel's Postgres backing store — NOT CockroachDB)
# -----------------------------
POSTGRES_DB=zitadel
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/zitadel?sslmode=disable

# -----------------------------
# Access logs
# -----------------------------
ZITADEL_ACCESS_LOG_STDOUT_ENABLED=true

# -----------------------------
# Fleetworks FIRSTINSTANCE bootstrap
# Only applied on the very first `start-from-init` run against an empty
# Postgres volume. To change these later, use the Console or Management API,
# or wipe the stack with `docker compose down -v` and start fresh.
# -----------------------------
FLEETWORKS_ORG_NAME=Fleetworks

# Initial human admin (IAM_OWNER). Log in at:
#   http://localhost:8080/ui/v2/login/login?login_hint=admin@fleetworks.local
FLEETWORKS_ADMIN_EMAIL=admin@fleetworks.local
FLEETWORKS_ADMIN_FIRSTNAME=Fleetworks
FLEETWORKS_ADMIN_LASTNAME=Admin
# Must satisfy the default password policy: >=8 chars, upper, lower, digit, symbol.
FLEETWORKS_ADMIN_PASSWORD=FleetworksLocal1!

# Machine user (also IAM_OWNER) used ONLY by scripts/seed.ts to drive the
# Management/Resource APIs headlessly. Its PAT and JSON machine key are
# written inside the container at /zitadel/bootstrap/ and are never persisted
# to a file on the host by the compose stack itself (the seed script reads
# them via `docker compose exec`).
FLEETWORKS_SEED_BOT_USERNAME=fleetworks-seed-bot
FLEETWORKS_SEED_BOT_NAME=Fleetworks Seed Automation
FLEETWORKS_SEED_BOT_EXPIRATION=2099-01-01T00:00:00Z
